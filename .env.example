# ─── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET=my-backups-bucket
S3_PREFIX=db-backups            # root folder inside the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── File storage backups (optional) ─────────────────────────────────────────
# Databases only cover structured data. Apps that keep user uploads / media on
# disk (WordPress wp-content, upload folders, docker volumes) need their files
# archived too to be fully restorable.
#
# Semicolon-separated list of  name:/absolute/path  entries. Each path is
# tar+gzip'd and uploaded to  {S3_PREFIX}/{name}/filestore/{TIMESTAMP}_{name}.tar.gz
# Root-owned paths (e.g. docker volume dirs) are read via passwordless sudo.
# Leave empty to back up databases only.
#
# Example:
#   FILESTORE_PATHS="wordpress:/var/lib/docker/volumes/site_wordpress/_data;myapp:/home/user/app/uploads"
FILESTORE_PATHS=""

# ─── MongoDB port override (optional) ────────────────────────────────────────
# The port mongod listens on is autodetected from the container's process, so
# non-default ports (e.g. `mongod --port 27018`) work with no config. Set this
# only to force a specific port when autodetection can't read the process.
MONGO_PORT=

# ─── Local staging dir (auto-cleaned after each upload) ──────────────────────
BACKUP_TMP_DIR=/tmp/db-backups

# ─── Retention: delete S3 objects older than N days (0 = keep forever) ───────
S3_RETENTION_DAYS=30

# ─── Status JSON path — read by status-server.sh ─────────────────────────────
STATUS_FILE=/var/www/backup-status/status.json
