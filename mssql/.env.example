# ─── S3 ───────────────────────────────────────────────────────────────────────
# Same bucket and credentials as the Linux fleet (copy them from an existing
# server's /opt/db-backups/.env). Use a per-server S3_PREFIX so backups from
# different hosts never collide inside the bucket.
S3_BUCKET=resit-prod-2026
S3_PREFIX=db-backups-alcsa
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── SQL Server ──────────────────────────────────────────────────────────────
# Instance to connect to: "." or "localhost" for the default instance,
# ".\SQLEXPRESS" for a named one.
SQL_INSTANCE=.

# Comma-separated list of databases to back up.
DATABASES=alcsaDESA

# Project name used in the S3 path:  {S3_PREFIX}/{PROJECT_NAME}/mssql/{TS}_{db}.bak
PROJECT_NAME=alcsa

# Leave SQL_USER empty to use Windows authentication (the account the scheduled
# task runs as — install.ps1 grants it the needed rights). Set both to use a
# SQL login instead.
SQL_USER=
SQL_PASSWORD=

# 1 = BACKUP ... WITH COMPRESSION (Standard edition or higher; Express has no
# backup compression — set 0 there).
BACKUP_COMPRESSION=1

# 1 = run RESTORE VERIFYONLY WITH CHECKSUM on every .bak before uploading it.
VERIFY=1

# ─── Local staging ───────────────────────────────────────────────────────────
# Folder where .bak files are written before upload. The SQL Server service
# account needs write access here (install.ps1 takes care of it).
BACKUP_DIR=C:\db-backups\staging

# Local .bak files older than this many days are deleted after each run
# (0 = delete every local file once uploaded, keep nothing).
LOCAL_KEEP_DAYS=1

# ─── Retention: delete S3 objects older than N days (0 = keep forever) ───────
S3_RETENTION_DAYS=15

# ─── Logs and status ─────────────────────────────────────────────────────────
LOG_DIR=C:\db-backups\logs
STATUS_FILE=C:\db-backups\status.json
